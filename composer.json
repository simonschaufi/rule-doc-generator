{
    "name": "simonschaufi/rule-doc-generator",
    "description": "Documentation generator for coding standard or static analysis rules",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "illuminate/container": "^8.83",
        "nette/robot-loader": "^3.0 || ^4.0",
        "nette/utils": "^3.2.10 || ^4.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/filesystem": "^5.4 || ^6.4 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0",
        "webmozart/assert": "^1.11 || ^2.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "phpstan/phpstan": "^2.1.34",
        "phpunit/phpunit": "^9.6.17 || ^10.0",
        "rector/rector": "^2.8.3",
        "symplify/easy-coding-standard": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "SimonSchaufi\\RuleDocGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimonSchaufi\\RuleDocGenerator\\Tests\\": "tests"
        },
        "classmap": [
            "stubs"
        ]
    },
    "bin": [
        "bin/rule-doc-generator"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "phpunit": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --dry-run --ansi"
    }
}
